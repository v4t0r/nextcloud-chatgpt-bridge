# Never commit real credentials. These values are for local/self-hosted mode only.
NEXTCLOUD_BASE_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=chatgpt-bridge
NEXTCLOUD_APP_PASSWORD=replace-with-app-password
NEXTCLOUD_ROOT_PATH=/ChatGPT
NEXTCLOUD_VERIFY_TLS=true
# Development escape hatch only. Keep false for any real deployment.
NEXTCLOUD_ALLOW_INSECURE_HTTP=false
# Safety cap for MCP text/base64 transfers (default 4 MB, hard max 25 MB).
NEXTCLOUD_MAX_TRANSFER_BYTES=4000000

# Hosted public-app deployment uses separate Bridge OAuth and storage configuration instead of
# NEXTCLOUD_USERNAME / NEXTCLOUD_APP_PASSWORD. Keep deployment secrets in the platform secret
# manager; the commented values below are placeholders, not working credentials.
# BRIDGE_AUTH_ISSUER_URL=https://auth.example.com/
# BRIDGE_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# BRIDGE_AUTH_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
# BRIDGE_RESOURCE_SERVER_URL=https://bridge.example.com/mcp
# BRIDGE_AUTH_AUDIENCE=https://bridge.example.com/mcp
# BRIDGE_AUTH_REQUIRED_SCOPES=nextcloud:use
# BRIDGE_AUTH_ALLOWED_ALGORITHMS=RS256
# BRIDGE_AUTH_CLIENT_MODE=cimd
# BRIDGE_AUTH_REQUIRE_USERINFO=false
# BRIDGE_DATABASE_URL=postgresql+psycopg://replace-user:replace-password@db.example/bridge
# BRIDGE_SECRET_ACTIVE_KEY_ID=primary
# BRIDGE_SECRET_KEYS_JSON={"primary":"replace-with-base64-encoded-32-byte-key"}
# BRIDGE_HOST=127.0.0.1
# PORT=8000
# BRIDGE_TRUSTED_HOSTS=bridge.example.com
# BRIDGE_ALLOWED_ORIGINS=
# BRIDGE_RATE_LIMIT_REQUESTS_PER_MINUTE=180
# BRIDGE_RATE_LIMIT_IP_REQUESTS_PER_MINUTE=1200
# BRIDGE_RATE_LIMIT_MAX_KEYS=20000
# BRIDGE_MAX_REQUEST_BODY_BYTES=4194304
# BRIDGE_WEBSITE_URL=https://www.example.com
# BRIDGE_SUPPORT_URL=https://www.example.com/support
# BRIDGE_PRIVACY_URL=https://www.example.com/privacy
# BRIDGE_TERMS_URL=https://www.example.com/terms
# OPENAI_APPS_CHALLENGE_TOKEN=replace-only-when-the-portal-issues-a-challenge
