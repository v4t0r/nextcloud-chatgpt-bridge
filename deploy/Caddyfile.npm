{
    admin off
    auto_https off
    servers {
        timeouts {
            read_header 10s
            idle 2m
        }
        trusted_proxies static {$NPM_PROXY_IP}
        trusted_proxies_strict
    }
}

:8081 {
    @npm {
        remote_ip {$NPM_PROXY_IP}
        host {$PUBLIC_DOMAIN}
    }
    handle @npm {
        header -Server
        reverse_proxy bridge:8000 {
            flush_interval -1
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
        }
    }
    handle {
        respond "Forbidden" 403
    }
}

:8082 {
    @npm {
        remote_ip {$NPM_PROXY_IP}
        host {$AUTH_DOMAIN}
    }
    handle @npm {
        header {
            -Server
            Strict-Transport-Security "max-age=31536000"
            X-Content-Type-Options nosniff
            Referrer-Policy no-referrer
        }
        request_body {
            max_size 1MB
        }
        @administration path /admin /admin/* /realms/master /realms/master/* /health /health/* /metrics
        respond @administration "Not found" 404
        reverse_proxy keycloak:8080 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
            header_up X-Forwarded-Host {$AUTH_DOMAIN}
            header_up X-Forwarded-For {client_ip}
        }
    }
    handle {
        respond "Forbidden" 403
    }
}
