PUBLIC_DOMAIN=mcp.example.com

BRIDGE_AUTH_ISSUER_URL=https://auth.example.com
BRIDGE_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
BRIDGE_AUTH_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
BRIDGE_AUTH_AUDIENCE=https://mcp.example.com/mcp
BRIDGE_AUTH_REQUIRED_SCOPES=nextcloud:use
BRIDGE_AUTH_ALLOWED_ALGORITHMS=RS256
BRIDGE_AUTH_CLIENT_MODE=cimd
BRIDGE_AUTH_REQUIRE_USERINFO=false

BRIDGE_WEBSITE_URL=https://www.example.com
BRIDGE_SUPPORT_URL=https://www.example.com/support
BRIDGE_PRIVACY_URL=https://www.example.com/privacy
BRIDGE_TERMS_URL=https://www.example.com/terms
BRIDGE_ALLOWED_ORIGINS=
BRIDGE_LOG_LEVEL=info
BRIDGE_RATE_LIMIT_REQUESTS_PER_MINUTE=180
BRIDGE_RATE_LIMIT_IP_REQUESTS_PER_MINUTE=1200
BRIDGE_RATE_LIMIT_MAX_KEYS=20000
BRIDGE_MAX_REQUEST_BODY_BYTES=4194304

BRIDGE_SECRET_ACTIVE_KEY_ID=primary
BRIDGE_DB_PASSWORD_FILE=./secrets/database-password.txt
BRIDGE_KEYRING_FILE=./secrets/credential-keyring.json

OPENAI_APPS_CHALLENGE_TOKEN=
